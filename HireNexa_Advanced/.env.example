# ==============================================================================
# HIRENEXA ENTERPRISE CONFIGURATION (.env.example)
# ==============================================================================

# ==============================================================================
# HIRENEXA ENTERPRISE CONFIGURATION (.env.example)
# Copy this file to .env and fill in your values.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-for-production
DJANGO_DEBUG=True
ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ==============================================================================
# SUPABASE POSTGRESQL DATABASE (Primary Database)
# ==============================================================================
# Get your connection string from:
#   https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/database
#
# Use session-mode pooler (port 5432) for local dev + Django migrations.
# Use transaction-mode pooler (port 6543) only for production high-concurrency.
#
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-DATABASE-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase REST API Keys (from Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Platform Owner 2FA OTP Setting (False = Password only, True = 2-Step Email OTP required)
OWNER_REQUIRE_OTP=False

# ==============================================================================
# Platform Owner Configuration & Automated Bootstrapping
# ------------------------------------------------------------------------------
OWNER_USERNAME=platform_owner
OWNER_EMAIL=owner@hirenexa.internal
OWNER_PASSWORD=your_secure_owner_master_password_here
OWNER_PHONE=+919876543210

# Test User Seeding (DEBUG=True Only)
TEST_USER_PASSWORD=your_test_user_password_here

# Rate Limiting & Account Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# ==============================================================================
# Google Gmail SMTP Configuration (Real Email Verification)
# ------------------------------------------------------------------------------
# Set EMAIL_BACKEND_MODE=smtp for real Gmail delivery, or =console for terminal output.
# When EMAIL_BACKEND_MODE=smtp and EMAIL_HOST_USER/PASSWORD are empty:
# - In DEBUG=True: automatically falls back to console.EmailBackend so developers can test OTPs without SMTP.
# - In DEBUG=False: raises ImproperlyConfigured to prevent deploying without email.
EMAIL_BACKEND_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Your full Gmail address
EMAIL_HOST_USER=your-email@gmail.com

# 16-character Google App Password (not your normal Google account password!)
# To generate:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named "HireNexa"
# 4. Paste the 16 characters below (spaces are automatically stripped):
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop

DEFAULT_FROM_EMAIL="HireNexa <your-email@gmail.com>"
EMAIL_TIMEOUT=20

# Resend API Configuration (Optional / Fast Alternative to SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ==============================================================================
# OTP AUTHENTICATION & MULTI-PORTAL SECURITY (Email & Mobile OTP)
# ==============================================================================
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_HOURLY_SENDS=5

# SMS Backend Provider Selection
# Options:
# - console  : Prints formatted OTP box to console/terminal (default in DEBUG)
# - fast2sms : Fast2SMS Quick SMS Gateway for India (https://www.fast2sms.com)
# - msg91    : Indian DLT-compliant SMS via MSG91 API
# - twilio   : Global SMS via Twilio API
SMS_BACKEND=console
SMS_API_KEY=your_sms_gateway_api_key_here

# Fast2SMS Settings (when SMS_BACKEND=fast2sms)
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# MSG91 Settings (when SMS_BACKEND=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_dlt_template_flow_id
MSG91_SENDER_ID=HIRNEX

# Twilio Settings (when SMS_BACKEND=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Custom SMS Gateway (optional)
CUSTOM_SMS_GATEWAY_URL=

# ==============================================================================
# AI ASSISTANT CONFIGURATION (Hybrid Architecture: Cloud + Local Platform)
# ==============================================================================
# Primary & Fallback Provider Preferences: 'openai', 'gemini', 'groq', 'anthropic', 'ollama', 'local'
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=ollama

# OpenAI (Primary cloud provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google AI Studio (Gemini 1.5 Flash via https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (Ultra-fast inference on open models via https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic Claude (via https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local / Private network offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Generation Parameters
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30.0
